{
  "name": "matriz-pratica-web",
  "version": "0.0.3",
  "description": "Aplicação web do Matriz Prática, construída com Next.js, React e PostgreSQL.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run service:up && npm run wait-for-postgres && npm run migration:up && next dev",
    "service:up": "docker compose -f infra/docker-compose.yaml up -d",
    "service:stop": "docker compose -f infra/docker-compose.yaml stop",
    "service:down": "docker compose -f infra/docker-compose.yaml down",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest --runInBand",
    "test:watch": "jest --watchAll --runInBand",
    "migration:create": "node-pg-migrate -m infra/migrations create",
    "migration:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "wait-for-postgres": "node infra/scripts/wait-for-postgres.js",
    "release:staging": "node infra/scripts/promote-to-master.js",
    "release:production": "node infra/scripts/promote-to-release.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jean8791/matriz-pratica-web.git"
  },
  "author": "Jean",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Jean8791/matriz-pratica-web/issues"
  },
  "homepage": "https://github.com/Jean8791/matriz-pratica-web#readme",
  "dependencies": {
    "@vercel/speed-insights": "^1.3.1",
    "dotenv": "^16.4.4",
    "dotenv-expand": "^11.0.6",
    "next": "16.0.7",
    "node-pg-migrate": "8.0.4",
    "pg": "8.11.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "prettier": "^3.7.4"
  }
}